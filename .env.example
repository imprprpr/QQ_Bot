# ─────────────────────────────────────────────────────────────
#  AnimaBot 配置
#  最简单的方式：双击「一键启动机器人.bat」（Linux/macOS：./start.sh），
#  第一次启动会自动打开配置向导，一步步帮你填好这个文件。
#  也可以手动运行：python tools/setup_wizard.py
#  全部可选项见 docs/config-reference.env
# ─────────────────────────────────────────────────────────────

# ── QQ 连接（NapCat 反向 WebSocket：ws://127.0.0.1:8080/onebot/v11/ws）──
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
# 与 NapCat 中填写的 Token 一致（向导会自动生成）；留空表示不校验，仅适合本机部署。
ONEBOT_ACCESS_TOKEN=

# ── 聊天模型（必填）──
# 任何 OpenAI 兼容接口都可以。启动后也能在本机管理页「模型提供商」里添加和一键切换。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 海外服务（Gemini、OpenAI、OpenRouter）在国内通常需要代理，例如 http://127.0.0.1:7890
LLM_PROXY=
LLM_TIMEOUT=90

# ── 角色（characters 目录里的文件名，不含 .json）──
DEFAULT_CHARACTER=ling

# ── 可选功能：需要额外的服务，准备好后再改成 true（见 README「进阶功能」）──
DRAW_ENABLED=false
TTS_ENABLED=false
LLM_VISION_ENABLED=false

# ── 群聊节奏（已调好的默认值，一般不用改）──
GROUP_CHAT_ENABLED=true
GROUP_CHAT_NICKNAMES=
GROUP_CHAT_PROBABILITY=0.08
GROUP_CHAT_COOLDOWN=300
GROUP_CHAT_NICKNAME_COOLDOWN=8
GROUP_CHAT_FOLLOWUP_MAX_ROUNDS=12
GROUP_CHAT_FOLLOWUP_HOURLY_LIMIT=60
GROUP_CHAT_FOLLOWUP_DAILY_LIMIT=120
GROUP_CHAT_AMBIENT_HOURLY_LIMIT=2
GROUP_CHAT_AMBIENT_GLOBAL_HOURLY_LIMIT=4
GROUP_CHAT_AMBIENT_DAILY_LIMIT=6
GROUP_CHAT_AMBIENT_GLOBAL_DAILY_LIMIT=12
