HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
# openai = existing DeepSeek + GLM; vertex = unified Gemini with ADC (no API key)
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# Optional HTTP proxy used for both ADC refresh and Vertex requests:
VERTEX_PROXY=
VERTEX_THINKING_LEVEL=LOW
VERTEX_MAX_OUTPUT_TOKENS=2048
VERTEX_HISTORY_IMAGES=4
IMAGE_CACHE_DIR=data/image_cache
IMAGE_CACHE_TTL=604800
IMAGE_CACHE_MAX_BYTES=268435456
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Keep your provider's supported model ID.
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=90
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7
# Optional provider-specific JSON, e.g. thinking controls:
LLM_EXTRA_BODY={}
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
VISION_MODEL=glm-4.6v
VISION_TEMPERATURE=0.3
VISION_EXTRA_BODY={}
DEFAULT_CHARACTER=ling
BOT_DATABASE=data/sessions.sqlite3
HISTORY_LIMIT=30
HISTORY_CHAR_LIMIT=16000
MAX_IMAGES=4
MAX_IMAGE_BYTES=10485760
COMFYUI_SERVER=http://127.0.0.1:8188
DRAW_TIMEOUT=600
DRAW_POLL_INTERVAL=2
DRAW_POSITIVE_NODE=3
DRAW_STEPS=22
DRAW_WIDTH=640
DRAW_HEIGHT=960
DRAW_CFG=4.5
DRAW_SAMPLER=euler_ancestral
DRAW_SCHEDULER=normal
# Optional fixed quality/style prefix; default is defined in comfyui.py.
# DRAW_BASE_TAGS=masterpiece, best quality
TTS_API_URL=http://127.0.0.1:9880/tts
TTS_REF_AUDIO=
TTS_PROMPT_TEXT=
TTS_PROMPT_LANG=zh
TTS_TIMEOUT=30
TTS_CACHE_DIR=data/tts_cache
TTS_CACHE_TTL=86400
# Anime reaction GIFs; no API key required. Set your actual contact identifier.
STICKER_ENABLED=true
STICKER_USER_AGENT=
# Empty inherits VERTEX_PROXY, or uses direct networking when neither is set.
STICKER_PROXY=
STICKER_COOLDOWN=30
# Curated local reactions are tried before the external API.
LOCAL_STICKER_DIR=data/sticker_library
# Maximum number of queued/running image jobs in this single bot process.
DRAW_QUEUE_LIMIT=8
# Optional management token override, at least 32 characters. Leave unset to generate data/admin-token.
# BOT_ADMIN_TOKEN=
