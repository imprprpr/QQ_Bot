HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
# Required: API key, OpenAI-compatible base URL and model ID.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7
LLM_EXTRA_BODY={}
# Optional HTTP proxy; leave empty for direct/system proxy configuration.
LLM_PROXY=
# Enable only if the chat model supports OpenAI image_url content.
LLM_VISION_ENABLED=false
# Optional separate vision service; empty values inherit the chat service.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TEMPERATURE=0.3
VISION_EXTRA_BODY={}
HISTORY_IMAGES=4
# Evidence-backed automatic event/preference memory; candidate messages add one bounded API call.
EVENT_MEMORY_ENABLED=true
EVENT_MEMORY_TIMEOUT=8
# Empty uses LLM_MODEL with the same key/base URL.
MEMORY_MODEL=
IMAGE_CACHE_DIR=data/image_cache
IMAGE_CACHE_TTL=604800
IMAGE_CACHE_MAX_BYTES=268435456
DEFAULT_CHARACTER=ling
BOT_DATABASE=data/sessions.sqlite3
HISTORY_LIMIT=30
HISTORY_CHAR_LIMIT=16000
MAX_IMAGES=4
MAX_IMAGE_BYTES=10485760
COMFYUI_SERVER=http://127.0.0.1:8188
DRAW_TIMEOUT=600
DRAW_QUEUE_LIMIT=8
DRAW_POLL_INTERVAL=2
DRAW_POSITIVE_NODE=3
DRAW_STEPS=22
DRAW_WIDTH=640
DRAW_HEIGHT=960
DRAW_CFG=4.5
DRAW_SAMPLER=euler_ancestral
DRAW_SCHEDULER=normal
# DRAW_BASE_TAGS=masterpiece, best quality
TTS_API_URL=http://127.0.0.1:9880/tts
TTS_REF_AUDIO=
TTS_PROMPT_TEXT=
TTS_PROMPT_LANG=zh
TTS_TIMEOUT=30
TTS_CACHE_DIR=data/tts_cache
TTS_CACHE_TTL=86400
STICKER_ENABLED=true
STICKER_USER_AGENT=
# Empty inherits LLM_PROXY.
STICKER_PROXY=
STICKER_COOLDOWN=30
LOCAL_STICKER_DIR=data/sticker_library
# Optional management token, at least 32 characters. Otherwise generated locally.
# BOT_ADMIN_TOKEN=
