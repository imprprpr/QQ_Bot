# AnimaBot 全部配置项参考（高级）
# 日常使用只需 .env.example 里的几项，推荐运行配置向导自动生成：python tools/setup_wizard.py
# 需要调整其他行为时，把下面对应的行复制到你的 .env 中再修改。
# 注意：DRAW_ENABLED / TTS_ENABLED 需要先准备好生图或语音服务，否则请保持 false。

HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
# 与 NapCat 反向 WebSocket 中填写的 Token 一致；留空则不校验（仅限本机部署）。
ONEBOT_ACCESS_TOKEN=
# Required: API key, OpenAI-compatible base URL and model ID.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=90
# Used by adapters built on the bounded HTTP transport; includes first attempt.
MODEL_HTTP_MAX_ATTEMPTS=2
MODEL_HTTP_ATTEMPT_TIMEOUT=35
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7
LLM_EXTRA_BODY={}
# Optional HTTP proxy; leave empty for direct/system proxy configuration.
LLM_PROXY=
# Enable only if the chat model supports OpenAI image_url content.
LLM_VISION_ENABLED=false
# Optional separate vision service; empty values inherit the chat service.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TEMPERATURE=0.3
VISION_MAX_TOKENS=2048
VISION_EXTRA_BODY={}
HISTORY_IMAGES=4
# Evidence-backed automatic event/preference memory; candidate messages add one bounded API call.
EVENT_MEMORY_ENABLED=true
EVENT_MEMORY_TIMEOUT=8
# Empty uses LLM_MODEL with the same key/base URL.
MEMORY_MODEL=
IMAGE_CACHE_DIR=data/image_cache
IMAGE_CACHE_TTL=604800
IMAGE_CACHE_MAX_BYTES=268435456
DEFAULT_CHARACTER=ling
BOT_DATABASE=data/sessions.sqlite3
HISTORY_LIMIT=30
HISTORY_CHAR_LIMIT=16000
MAX_IMAGES=4
MAX_IMAGE_BYTES=10485760
COMFYUI_SERVER=http://127.0.0.1:8188
DRAW_ENABLED=false
# comfyui preserves the local workflow; api uses a service or trusted adapter.
DRAW_BACKEND=comfyui
DRAW_API_KEY=
DRAW_API_BASE_URL=https://api.openai.com/v1
DRAW_API_MODEL=dall-e-3
DRAW_API_STYLE=photography
DRAW_API_SIZE=1024x1024
DRAW_PROXY=
# Optional trusted local Python file with async generate_image(prompt) -> bytes.
DRAW_CLIENT_FACTORY=
DRAW_TIMEOUT=600
DRAW_QUEUE_LIMIT=8
DRAW_POLL_INTERVAL=2
DRAW_POSITIVE_NODE=3
DRAW_STEPS=22
DRAW_WIDTH=640
DRAW_HEIGHT=960
DRAW_CFG=4.5
DRAW_SAMPLER=euler_ancestral
DRAW_SCHEDULER=normal
# DRAW_BASE_TAGS=masterpiece, best quality
TTS_API_URL=http://127.0.0.1:9880/tts
TTS_ENABLED=false
# gpt-sovits, google-chirp3, or genie (independent local HTTP service)
TTS_BACKEND=gpt-sovits
GENIE_CHARACTER=default
TTS_CHARACTERS_FILE=data/tts_characters.json
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=cmn-CN-Chirp3-HD-Kore
GOOGLE_TTS_SPEAKING_RATE=1
GOOGLE_TTS_VOLUME_GAIN_DB=0
TTS_VOICES_FILE=data/tts_voices.json
# Use base64 when NapCat runs in Docker and cannot access host file paths.
TTS_DELIVERY=file
TTS_PROXY=
TTS_REF_AUDIO=
TTS_PROMPT_TEXT=
TTS_PROMPT_LANG=zh
TTS_TIMEOUT=30
TTS_CACHE_DIR=data/tts_cache
TTS_CACHE_TTL=86400
STICKER_ENABLED=true
STICKER_USER_AGENT=
# Empty inherits LLM_PROXY.
STICKER_PROXY=
STICKER_COOLDOWN=30
LOCAL_STICKER_DIR=data/sticker_library
# Optional management token, at least 32 characters. Otherwise generated locally.
# BOT_ADMIN_TOKEN=

# Group messages are screened locally; only selected messages call the chat model.
GROUP_CHAT_ENABLED=true
# 群里叫这些名字时会回应，逗号分隔；留空时使用默认角色的名字。
GROUP_CHAT_NICKNAMES=
# Empty allows all joined groups. Comma-separated group IDs restrict nickname/ambient triggers.
# Real @ mentions continue to work even when these new features are disabled.
GROUP_CHAT_GROUPS=
# Three independent budgets; explicit human @ mentions are exempt.
GROUP_CHAT_NICKNAME_COOLDOWN=8
GROUP_CHAT_NICKNAME_HOURLY_LIMIT=20
GROUP_CHAT_NICKNAME_GLOBAL_HOURLY_LIMIT=40
GROUP_CHAT_NICKNAME_DAILY_LIMIT=60
GROUP_CHAT_NICKNAME_GLOBAL_DAILY_LIMIT=120
GROUP_CHAT_FOLLOWUP_ENABLED=true
GROUP_CHAT_FOLLOWUP_WINDOW=300
GROUP_CHAT_FOLLOWUP_COOLDOWN=5
GROUP_CHAT_FOLLOWUP_MAX_ROUNDS=12
GROUP_CHAT_FOLLOWUP_HOURLY_LIMIT=60
GROUP_CHAT_FOLLOWUP_GLOBAL_HOURLY_LIMIT=120
GROUP_CHAT_FOLLOWUP_DAILY_LIMIT=120
GROUP_CHAT_FOLLOWUP_GLOBAL_DAILY_LIMIT=240
GROUP_CHAT_AMBIENT_ENABLED=true
GROUP_CHAT_PROBABILITY=0.08
GROUP_CHAT_COOLDOWN=300
GROUP_CHAT_AMBIENT_HOURLY_LIMIT=2
GROUP_CHAT_AMBIENT_GLOBAL_HOURLY_LIMIT=4
GROUP_CHAT_AMBIENT_DAILY_LIMIT=6
GROUP_CHAT_AMBIENT_GLOBAL_DAILY_LIMIT=12

# 私聊主动问候默认开启，可用 /proactive off 关闭；不向群聊主动推送。
# 两次主动生成尝试之间至少6小时，硬下限3小时；用户回复不会清除此冷却。
PROACTIVE_COOLDOWN_HOURS=6
# 所有私聊合计每天最多6次尝试，0为暂停全局主动聊天，最多可设20。
PROACTIVE_GLOBAL_DAILY_LIMIT=6
# windows: 08–10 / 12–14 / 19–22 窗口随机；random: 08–22 随机。
PROACTIVE_MODE=windows
PROACTIVE_UTC_OFFSET=8
PROACTIVE_IDLE_HOURS=3
PROACTIVE_DAILY_LIMIT=2

# 指定机器人互动：QQ号和群号都必须填写，留空不触发。仅公开群聊。
BOT_INTERACTION_ENABLED=true
# 多个QQ号/群号用英文逗号分隔，不能填 all。仅与明确配置的对象互动。
BOT_INTERACTION_TARGETS=
BOT_INTERACTION_GROUPS=
# 傲娇斗嘴，仅文字，程序添加真实@；最大轮次硬上限3，默认我方最多2条。
BOT_INTERACTION_MAX_ROUNDS=2
BOT_INTERACTION_SESSION_SECONDS=180
BOT_INTERACTION_COOLDOWN=600
BOT_INTERACTION_REPLY_COOLDOWN=5
BOT_INTERACTION_REPLY_PROBABILITY=0.3
# 每群每小时最多6次生成尝试，全局滚动24小时最多12次，失败/不参与也计数。
BOT_INTERACTION_HOURLY_LIMIT=6
BOT_INTERACTION_DAILY_LIMIT=12
# 每5分钟检查，近期15分钟有公开消息的配置群可主动搭话；08–22点。
BOT_INTERACTION_PROACTIVE_PROBABILITY=0.2
BOT_INTERACTION_PROACTIVE_DAILY_LIMIT=3
BOT_INTERACTION_UTC_OFFSET=8

# 可选：使用 NapCat 群号/QQ管理插件时填写共享配置文件的宿主机绝对路径。
# 留空继续读取上面的号码列表；填写后号码列表由该文件覆盖、保存即热更新。
BOT_INTERACTION_CONFIG_FILE=

# 专业代码分析自动按需启用，不新增分类API请求。仅直接回应放宽输出预算。
# 未明确@的群聊仍遵守180 token预算和160字限制。
CODE_ANALYSIS_MAX_TOKENS=1400

# NapCat 插件共享模型配置文件的宿主机路径；留空使用原部署配置。
# 页面保存的密钥位于服务器私有文件，不应加入 Git 或发布包。
BOT_MODEL_CONFIG_FILE=

# NapCat 主动聊天管理页共享文件；留空时采用 PROACTIVE_* 环境变量。
BOT_PROACTIVE_CONFIG_FILE=

# NapCat 群聊与互聊共享策略；留空沿用环境变量，接入后保存即可热生效。
BOT_PARTICIPATION_CONFIG_FILE=

# NapCat 人设库与按QQ分配的共享文件；留空不启用管理页覆盖。
# 保存后后续请求热生效，人设/分配均为私有数据，不要加入Git。
BOT_PERSONA_CONFIG_FILE=
