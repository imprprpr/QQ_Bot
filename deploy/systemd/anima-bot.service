# Template: run `sudo deploy/systemd/install.sh` from the project folder to fill in the
# user and paths and install it. Placeholders: __USER__, __DIR__.
[Unit]
Description=AnimaBot QQ companion
Wants=network-online.target
After=network-online.target
# Continue retrying after prolonged outages; RestartSec prevents a tight loop.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/.venv/bin/python __DIR__/bot.py
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
